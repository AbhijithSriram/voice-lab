# Copy to /etc/voice-lab.env, fill in, then:
#   sudo chown root:root /etc/voice-lab.env && sudo chmod 600 /etc/voice-lab.env
#
# systemd parses this itself -- it is not a shell. Do not quote values, do not
# use $substitutions, and keep the admin code free of '#' (it starts a comment).

# Signs the session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Unset, config.py invents one per process: everybody is silently logged out on
# every restart and on every deploy. Set it once and leave it alone -- changing
# it later logs everyone out.
VOICELAB_SECRET_KEY=

# Typed on the signup form to create an admin account. Anyone who knows it is
# an admin, and this host is on the public internet, so it is a password.
# Unset, config.py defaults it to 'let-me-in'.
VOICELAB_ADMIN_CODE=

# Cloudflare terminates TLS, so Flask sees plain http from the tunnel. Without
# this it builds http:// URLs, the browser calls the page insecure, and
# getUserMedia refuses to hand over the microphone -- the app looks broken in a
# way that has nothing to do with audio.
VOICELAB_BEHIND_PROXY=1

# Database and recordings. Outside /opt/voice-lab on purpose: the unit mounts
# the code read-only, and subject audio should survive `git pull` regardless.
VOICELAB_DATA_DIR=/var/lib/voicelab
