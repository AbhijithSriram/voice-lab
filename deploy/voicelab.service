# systemd unit for the voice lab. Installed by deploy/install.sh.
#
# Logs:  journalctl -u voicelab -f

[Unit]
Description=Voice Lab (labelled voice samples for the pwiews acoustic pipeline)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=abhijith
Group=abhijith

WorkingDirectory=/home/abhijith/voice-lab
# run.py imports the top-level `config` module, so the project root has to be
# importable. gunicorn adds WorkingDirectory to sys.path already; this is the
# belt to that pair of braces.
Environment=PYTHONPATH=/home/abhijith/voice-lab
Environment=PYTHONUNBUFFERED=1

# Secrets live here, not in the unit file and not in the repository.
EnvironmentFile=/etc/voice-lab.env

# One worker, several threads. Not a throughput decision -- a correctness one.
# db.py opens a fresh sqlite3 connection per call with the default rollback
# journal and a 5 s busy timeout. Several *processes* writing that database is
# how you get "database is locked" in the middle of a demo; several threads in
# one process is not.
ExecStart=/home/abhijith/voice-lab/.venv/bin/gunicorn \
    --workers 1 \
    --threads 8 \
    --timeout 120 \
    --bind 127.0.0.1:5000 \
    --access-logfile - \
    --error-logfile - \
    "voicelab.app:create_app()"

# `always`, not `on-failure` as the other units here use: gunicorn exiting 0
# because its last worker died is still an outage, and this should come back
# from that too.
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
# ProtectSystem=strict mounts the WHOLE hierarchy read-only, not just /usr and
# /etc -- everything outside /dev, /proc and /sys. ProtectHome=false hands back
# /home (the code, the venv, gunicorn's control socket in ~/.gunicorn), but
# /srv stays read-only unless it is named here, and sqlite answers a read-only
# directory with "attempt to write a readonly database" on the first INSERT.
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/srv/nas/voice-lab
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
